# jupyter-remote-exec 설정 예제
# 이 파일을 config.toml로 복사하여 사용하세요
# 위치: 프로젝트 루트 또는 ~/.config/jupyter-remote-exec/config.toml

# 공유 토큰 (선택사항)
# 모든 리모트에서 사용할 기본 토큰
shared_token = "your_shared_token_here"

# 전역 기본값 (선택사항)
[defaults]
https = false  # 기본 HTTP/WS 사용
verify = true  # 기본 인증서 검증 활성화

# 리모트 서버 설정
[remotes.us-east]
host = "east-server.example.com"
port = 8888
https = true
verify = "/path/to/ca-bundle.pem"  # 또는 true/false
# token = "per-remote-token"  # 리모트별 토큰 (공유 토큰보다 우선)

[remotes.us-west]
host = "west-server.example.com"
port = 8888
https = true
verify = false  # 자체 서명 인증서 사용 시

[remotes.eu-central]
host = "eu-server.example.com"
port = 8888
# https와 verify를 지정하지 않으면 defaults 또는 기본값(false) 사용

[remotes.local]
host = "localhost"
port = 8888
# 로컬 개발 서버 (토큰 없이 접속 가능하도록 설정된 경우)
